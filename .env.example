# Copy this file to .env and add your key to enable AI mode (understands any prompt).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: Generative mode (like the Gemini app) – lets any prompt edit the photo,
# e.g. remove objects, change background/sky. Get a key at https://aistudio.google.com/
GEMINI_API_KEY=
# When set, EVERY prompt is sent to Gemini so the photo is edited exactly as described.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Higher quality / up to 4K output (paid tier):
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# GEMINI_IMAGE_SIZE=2K   # 1K, 2K or 4K (gemini-3 models only)
